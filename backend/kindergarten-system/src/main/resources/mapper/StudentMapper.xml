<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kindergarten.system.mapper.StudentMapper">

    <select id="selectStudentPage" resultType="com.kindergarten.system.entity.Student">
        SELECT s.*, c.class_name AS className
        FROM student s
        LEFT JOIN class_info c ON s.class_id = c.id
        <where>
            <if test="query.name != null and query.name != ''">
                AND s.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.classId != null">
                AND s.class_id = #{query.classId}
            </if>
            <if test="query.status != null and query.status != ''">
                AND s.status = #{query.status}
            </if>
        </where>
        ORDER BY s.id DESC
    </select>

    <select id="selectStudentsForExport" resultType="com.kindergarten.system.entity.Student">
        SELECT s.*, c.class_name AS className
        FROM student s
        LEFT JOIN class_info c ON s.class_id = c.id
        <where>
            <if test="query.name != null and query.name != ''">
                AND s.name LIKE CONCAT('%', #{query.name}, '%')
            </if>
            <if test="query.classId != null">
                AND s.class_id = #{query.classId}
            </if>
            <if test="query.status != null and query.status != ''">
                AND s.status = #{query.status}
            </if>
        </where>
        ORDER BY s.id DESC
    </select>

</mapper>