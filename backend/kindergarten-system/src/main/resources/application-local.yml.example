# ====================================================
# ⚠️ 本地开发配置模板
# ====================================================
# 使用方法：
#   1. 复制此文件为 application-local.yml
#   2. 填入真实的数据库、JWT、R2 等凭证
#   3. application-local.yml 已被 .gitignore 忽略，不会提交到 Git
# ====================================================

spring:
  datasource:
    url: jdbc:mysql://你的数据库地址:端口/kindergarten_db?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
    username: 你的数据库用户名
    password: 你的数据库密码

jwt:
  secret: 你的JWT密钥-至少32字节的随机字符串

r2:
  endpoint: https://你的R2端点.r2.cloudflarestorage.com
  access-key: 你的R2-Access-Key
  secret-key: 你的R2-Secret-Key
  bucket: 你的Bucket名称
  public-url: https://你的公开访问域名
